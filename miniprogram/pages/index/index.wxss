.page { padding: 28rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.title { font-size: 40rpx; font-weight: 650; margin: 4rpx 0 24rpx; }
.upload-row, .export-row, .chips, .file-row { display: flex; gap: 12rpx; }
.upload-row button, .export-row button { flex: 1; margin: 0; padding: 0 12rpx; }
.primary { background: #826246; color: #fff; }
.secondary { background: #ede6dd; color: #5c4534; }
button[disabled] { opacity: .5; }
.source { display: block; width: 100%; height: 300rpx; background: #fff; border-radius: 18rpx; margin-top: 18rpx; }
.empty { padding: 54rpx 0; margin-top: 18rpx; text-align: center; color: #958a80; border: 2rpx dashed #d9cfc4; border-radius: 18rpx; }
.label { font-size: 25rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.chip { flex: 1; margin: 0; padding: 0 4rpx; font-size: 24rpx; background: #fff; color: #77695c; border: 2rpx solid #e7dfd5; }
.chip.selected { border-color: #826246; color: #62452d; background: #f1e7dc; }
.dither-row { display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; margin-top: 14rpx; }
.status { font-size: 24rpx; margin: 16rpx 0; color: #77644e; }
.error { padding: 18rpx; border-radius: 12rpx; color: #9d3f37; background: #ffefeb; margin: 14rpx 0; font-size: 25rpx; }
.preview-box { margin-top: 24rpx; background: #fff; border: 2rpx solid #e6ded5; border-radius: 18rpx; overflow: hidden; }
.preview { width: 100%; height: 680rpx; }
.preview-caption { padding: 14rpx 18rpx; font-size: 23rpx; color: #857362; }
.preview-caption text { float: right; }
.export-row { margin-top: 20rpx; }
.export-row button { font-size: 23rpx; }
.demo { font-size: 22rpx; color: #927651; margin-top: 16rpx; line-height: 1.55; }
.muted { color: #8e8175; font-weight: normal; font-size: 22rpx; margin-left: 10rpx; }
.stats { display: flex; flex-wrap: wrap; row-gap: 14rpx; }
.stat { width: 25%; display: flex; align-items: center; gap: 5rpx; font-size: 19rpx; white-space: nowrap; }
.swatch { width: 18rpx; height: 18rpx; flex-shrink: 0; border: 1rpx solid #ddd2c4; border-radius: 4rpx; }
.offscreen { position: fixed; left: -3000px; top: -3000px; width: 1px; height: 1px; pointer-events: none; }
.file-row button { margin: 0; }
.zoom { position: fixed; z-index: 10; inset: 0; background: #faf8f5; padding-top: env(safe-area-inset-top); }
.zoom-header { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; }
.zoom-header button { margin: 0; }
.zoom-area { width: 100vw; height: calc(100vh - 130rpx); overflow: hidden; }
.zoom-movable { width: 100vw; height: 100vw; }
.zoom-canvas { width: 100vw; height: 100vw; }
